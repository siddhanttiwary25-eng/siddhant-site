---
// Magazine folio at the foot of a spread: the page number on the left, "Ideas  03" on the right.
interface Props {
  page: number;
  label: string;
}
const { page, label } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<footer class="folio">
  <span><b>{pad(page)}</b></span>
  <span>{label} <b>{pad(page + 1)}</b></span>
</footer>
