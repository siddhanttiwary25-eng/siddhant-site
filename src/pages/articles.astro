---
import Section from '../layouts/Section.astro';
import { h } from '../data/site';
import { readArticles } from '../data/pages';

const groups = [
  // { heading: 'My articles', items: myArticles },  hidden for now; entries stay in pages.ts
  { heading: 'Recently read', items: readArticles },
];
---
<Section
  page={8}
  title="Articles"
  intro="What I’ve been reading lately."
  mirror
  heads={[h('lion-tailed-macaque'), h('common-marmoset'), h('macacus-libidinosus'), h('red-bellied-guenon'), h('silvery-marmoset'), h('monk-saki'), h('proboscis-monkey'), h('king-colobus'), h('red-howler'), h('black-tufted-marmoset')]}
>
  {groups.map((g, i) => (
    <>
      <h2 class="subhead" style={i > 0 ? 'margin-top:36px' : undefined}>{g.heading}</h2>
      <ol class="list">
        {g.items.map((a) => (
          <li id={a.id || undefined}>
            <a class="item" href={a.href} target={a.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              <span class="meta" style="display:flex;gap:10px;align-items:baseline"><span class="tag">{a.source}</span>{a.meta}</span>
              <span class="item-title" style="margin-top:6px">{a.title}{a.href.startsWith('http') && ' ↗'}</span>
              <span class="item-sum">{a.why}</span>
            </a>
          </li>
        ))}
      </ol>
    </>
  ))}
</Section>
