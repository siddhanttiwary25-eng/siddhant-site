---
// One of my own articles, told as an illustrated, interactive story.
// The words still live in src/writing/may-day-mystery.md (one paragraph per block, in order);
// the charts read src/data/mayday.json (exported from ~/Downloads/mayday-mystery/tools/export_site_data.py).
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Folio from '../../components/Folio.astro';
import { site } from '../../data/site';
import { formatDate, readMinutes } from '../../utils';
import { frontmatter, rawContent } from '../../writing/may-day-mystery.md';
import data from '../../data/mayday.json';

const paras = rawContent().trim().split(/\n\s*\n/).map((p) => p.trim());
const P = (i: number) => paras[i] ?? '';

const graveyard = [
  { t: 'The numbers hide a layer of mathematics', f: 'Died', why: 'They hit famous constants about as often as random numbers do.' },
  { t: 'The misspellings spell a secret message', f: 'Died', why: '44 confirmed misspelled letters. No message in English, Latin or German.' },
  { t: 'The ads set each other off in waves', f: 'Died', why: 'An early hint vanished once each era’s favourite topics were accounted for.' },
  { t: 'It is all random noise', f: 'Died', why: 'The calendar, the cast and the cross-references are far too consistent.' },
  { t: 'It is one long serial story', f: 'Died', why: 'The characters are a stock for each era, not a plot that carries forward.' },
  { t: '8/30/69 is a Texas rock festival', f: 'Unproven', why: 'My own idea. None of the ads that print the date mention Texas.' },
  { t: 'One person wrote every ad', f: 'Can’t tell', why: 'Leans that way, but there isn’t enough surviving text to decide.' },
  { t: 'The ads keep a sacred calendar', f: 'Survived', why: 'Every printed anniversary count is right, checked blind.' },
  { t: 'Ads that pray also joke', f: 'Survived', why: 'Held up with two Claude coders and with Jev, from another company.' },
];

const rungs = [
  { k: 'a', t: 'Random', d: 'Pages thrown together with no plan.', v: 'Ruled out', e: 'Real ads keep dates consistent 88% of the time; shuffled fakes, 2%. One ad is cited by 29 others.' },
  { k: 'b', t: 'Collage', d: 'Each year rebuilt from a stock of themes, inside a fixed ritual.', v: 'Where the evidence lands', e: 'The design lives in the calendar, the header and the cross-references, not in how each page hangs together.' },
  { k: 'c', t: 'Composed story', d: 'A single work whose parts were written to fit together.', v: 'Not reached', e: 'Real ads don’t hang together better than fakes rebuilt from their own parts.' },
  { k: 'd', t: 'Hidden code', d: 'A message encrypted inside the text.', v: 'No evidence', e: 'Nothing found in the numbers, misspellings or underlines, though the tools for finding a code are weak.' },
];
---
<Base title={`${frontmatter.title} — ${site.name}`} description={frontmatter.summary}>
  <Header back />
  <article class="mdm">
    <header class="mdm-top">
      <p class="kicker">Article · {formatDate(new Date(frontmatter.date))} · {readMinutes(rawContent())} min read · Interactive</p>
      <h1>{frontmatter.title}</h1>
      <p class="mdm-stand">{frontmatter.summary}</p>
    </header>

    <figure class="exh exh-wide reveal">
      <figcaption class="cap"><span class="pl">Exh. I</span> <b>The first ad</b> · May Day, 1981. “Long live Chairman Mao,” in Chinese.</figcaption>
      <img src="/mayday/1981-05-01.webp" width="800" height="403" alt="The first May Day Mystery ad, 1981: hand-lettered 'SR/CL: Richmond', Chinese characters reading 'Long live Chairman Mao', and 'May Day, 1981'." />
    </figure>

    <div class="mdm-text dropcap"><p>{P(0)}</p></div>

    <section class="chart reveal" aria-labelledby="t-time">
      <p class="chart-k">Figure 1</p>
      <h2 id="t-time">Forty-five Mays</h2>
      <p class="chart-d">Every ad in the archive, 1981 to 2026. Filled marks ran on or around May Day; open marks ran on other dates. Hover or tap a mark.</p>
      <div id="timeline" class="viz" role="img" aria-label="Timeline of 116 ads from 1981 to 2026"></div>
      <p class="readout" id="time-out">&nbsp;</p>
    </section>

    <div class="mdm-text"><p>{P(1)}</p></div>

    <figure class="exh exh-half reveal">
      <figcaption class="cap"><span class="pl">Exh. II</span> <b>The count</b> · June 2026. “496th Anniversary of the Confessio Augustana.” 1530 + 496 = 2026.</figcaption>
      <img src="/mayday/2026-06-22.webp" width="1000" height="1016" alt="The June 2026 ad: a headline reading '496th Anniversary of the Confessio Augustana' above a photograph of clouds over water." />
    </figure>

    <section class="chart reveal" aria-labelledby="t-cal">
      <p class="chart-k">Figure 2</p>
      <h2 id="t-cal">The calendar never slips</h2>
      <p class="chart-d">Drag the year. The line is what the count <i>should</i> be (year − 1530). The dots are what the ads actually printed.</p>
      <div class="calc">
        <input type="range" id="yr" min="1987" max="2026" value="1989" aria-label="Year" />
        <p class="calc-out"><span id="yr-y">1989</span> → the <b id="yr-n">459th</b> anniversary of 25 June 1530</p>
      </div>
      <div id="calendar" class="viz" role="img" aria-label="Printed anniversary counts against the expected count; all fall on the line"></div>
      <p class="readout" id="cal-out"><b>34 of 34</b> printed counts sit on the line, including two years I locked away and predicted before looking.</p>
    </section>

    <div class="mdm-text"><p>{P(2)}</p></div>

    <figure class="exh exh-tall reveal">
      <figcaption class="cap"><span class="pl">Exh. III</span> <b>The keystone</b> · May Day, 1989. Cromwell, a Julian date, a bar of music and a Hebrew psalm.</figcaption>
      <img src="/mayday/1989-05-01.webp" width="1000" height="1583" alt="The full-page May Day 1989 ad: a crayon portrait captioned CROMWELL, surrounded by equations, a Greek-letter matrix, Hebrew and Greek scripture, a diagram and numbered instructions." />
    </figure>

    <section class="chart reveal" aria-labelledby="t-cite">
      <p class="chart-k">Figure 3</p>
      <h2 id="t-cite">The ad everyone points back to</h2>
      <p class="chart-d">Later ads often quote earlier ones by date. These ten are quoted most. The dashed line is the most chance alone would give, 99 times in 100.</p>
      <div id="cites" class="viz" role="img" aria-label="Bar chart: the 1989 ad is cited 41 times, more than twice the chance ceiling of 18"></div>
    </section>

    <div class="mdm-text"><p>{P(3)}</p></div>

    <section class="chart reveal" aria-labelledby="t-grave">
      <p class="chart-k">Figure 4</p>
      <h2 id="t-grave">The graveyard of theories</h2>
      <p class="chart-d">Nine ideas, each tested against rules written down before looking. Tap a card to see what happened to it.</p>
      <ol class="grave">
        {graveyard.map((g) => (
          <li>
            <button class="card" type="button" aria-expanded="false" data-fate={g.f}>
              <span class="card-t">{g.t}</span>
              <span class="card-b"><b class="fate">{g.f}</b><span>{g.why}</span></span>
              <span class="card-hint">Tap to reveal</span>
            </button>
          </li>
        ))}
      </ol>
      <p class="readout" id="grave-out">0 of 9 revealed</p>
    </section>

    <section class="chart reveal" aria-labelledby="t-ladder">
      <p class="chart-k">Figure 5</p>
      <h2 id="t-ladder">So what are they?</h2>
      <p class="chart-d">Four answers, from least meaning to most. Tap a rung.</p>
      <div class="ladder">
        <ol class="rungs">
          {rungs.map((r) => (
            <li><button type="button" class={`rung${r.k === 'b' ? ' on here' : ''}`} data-k={r.k} data-v={r.v} data-e={r.e} data-d={r.d}>
              <span class="rung-l">{r.k}</span><span class="rung-t">{r.t}</span><span class="rung-v">{r.v}</span>
            </button></li>
          ))}
        </ol>
        <div class="rung-panel" aria-live="polite">
          <p class="rung-pk" id="rung-v">Where the evidence lands</p>
          <p class="rung-pd" id="rung-d">Each year rebuilt from a stock of themes, inside a fixed ritual.</p>
          <p class="rung-pe" id="rung-e">The design lives in the calendar, the header and the cross-references, not in how each page hangs together.</p>
        </div>
      </div>
    </section>

    <figure class="exh exh-tall reveal">
      <figcaption class="cap"><span class="pl">Exh. IV</span> <b>Prayer and play</b> · May Day, 2008. Luther, Calvin and Cromwell; an “Orate pro nobis” beside a “cybernetically sealed invitation”.</figcaption>
      <img src="/mayday/2008-05-01.webp" width="1100" height="1549" alt="The May Day 2008 ad: a cross-shaped collage of old engravings labelled Luther, Calvin, Cromwell and Gustavus Adolphus, with physics equations, a matrix and a paragraph announcing the 478th anniversary." />
    </figure>

    <div class="mdm-text"><p>{P(4)}</p></div>

    <section class="chart reveal" aria-labelledby="t-pj">
      <p class="chart-k">Figure 6</p>
      <h2 id="t-pj">Ads that pray also joke</h2>
      <p class="chart-d">Each dot is one ad. Across: how much of it is prayer. Up: how playful its <i>other</i> lines are. Switch who did the reading.</p>
      <div class="seg" role="tablist" aria-label="Who labelled the lines">
        <button type="button" role="tab" aria-selected="true" data-who="claude">Claude (two models)</button>
        <button type="button" role="tab" aria-selected="false" data-who="jev">Jev (another company)</button>
        <button type="button" role="tab" aria-selected="false" data-who="majority">All three, by vote</button>
      </div>
      <div id="prayjoke" class="viz" role="img" aria-label="Scatter plot of prayer share against play share, rising to the right"></div>
      <p class="readout" id="pj-out">&nbsp;</p>
    </section>

    <div class="mdm-text"><p>{P(5)}</p></div>

    <section class="sealed reveal" aria-label="Sealed predictions">
      <p class="chart-k">Sealed</p>
      <p class="sealed-n"><span id="days">—</span> days</p>
      <p class="sealed-d">until May Day 2027, when eight predictions I locked away get opened and scored.</p>
    </section>

    <footer class="mdm-end">
      <p class="subhead">The project</p>
      <ul class="mdm-links">
        <li><a href="https://github.com/siddhanttiwary25-eng/may-day-mystery" target="_blank" rel="noopener">Code, plans and graded results on GitHub ↗</a></li>
        <li><a href="/articles">More articles</a></li>
      </ul>
      <p class="mdm-credit">Ads reproduced from Bryan Hance’s archive at maydaymystery.org; they first ran in the <i>Arizona Daily Wildcat</i>. Shown in greyscale, for commentary.</p>

      <section class="mdm-refs" aria-labelledby="refs">
        <p class="subhead" id="refs">Sources</p>

        <p class="refs-k">The ads and earlier reporting</p>
        <ol>
          <li>Hance, Bryan. <i>May Day Mystery</i> (archive of the ads). maydaymystery.org/mayday. All 116 ads were read from this archive, through Wayback Machine copies.</li>
          <li>“The Great May Day Mystery: Mysterious Ads Placed in College Newspaper for More Than 20 Years.” <i>Tucson Local Media</i>, May 13, 2003.</li>
          <li>Towne, Douglas. “Arizona’s da Vinci Code.” <i>Phoenix Magazine</i>, May 1, 2017.</li>
          <li>O’Rourke, Ciara. “The Great Campus Paper Caper.” <i>Deseret Magazine</i>, November 2022.</li>
          <li>“Arizona Daily Wildcat.” <i>Wikipedia</i>.</li>
          <li>“Augsburg Confession” (presented June 25, 1530). <i>Wikipedia</i>.</li>
        </ol>

        <p class="refs-k">Models and methods</p>
        <ol start="7">
          <li>Smith, Ray. “An Overview of the Tesseract OCR Engine.” <i>ICDAR 2007</i>, vol. 2, 629–633. doi:10.1109/ICDAR.2007.4376991. Used to read the scans.</li>
          <li>Wang, Liang, et al. “Multilingual E5 Text Embeddings: A Technical Report.” 2024. arXiv:2402.05672. Model: multilingual-e5-base.</li>
          <li>Zhai, Xiaohua, et al. “Sigmoid Loss for Language Image Pre-Training.” 2023. arXiv:2303.15343. Model: siglip-base-patch16-224, for the drawings.</li>
          <li>Oquab, Maxime, et al. “DINOv2: Learning Robust Visual Features without Supervision.” 2023. arXiv:2304.07193. Model: dinov2-base, for the drawings.</li>
          <li>TypeSafe AI. Jev (model jev-1.14.0), the outside checker. typesafe.ai. The other two readers were Anthropic’s Claude Opus and Claude Sonnet.</li>
          <li>Burrows, John. “‘Delta’: A Measure of Stylistic Difference and a Guide to Likely Authorship.” <i>Literary and Linguistic Computing</i> 17, no. 3 (2002): 267–287. doi:10.1093/llc/17.3.267. The one-author-or-many test.</li>
          <li>Campello, Ricardo, Davoud Moulavi, and Jörg Sander. “Density-Based Clustering Based on Hierarchical Density Estimates.” <i>PAKDD 2013</i>, 160–172. doi:10.1007/978-3-642-37456-2_14. HDBSCAN, for themes.</li>
          <li>Blondel, Vincent, et al. “Fast Unfolding of Communities in Large Networks.” <i>Journal of Statistical Mechanics</i> (2008): P10008. doi:10.1088/1742-5468/2008/10/P10008. Louvain, for the citation network.</li>
          <li>Hawkes, Alan. “Spectra of Some Self-Exciting and Mutually Exciting Point Processes.” <i>Biometrika</i> 58, no. 1 (1971): 83–90. doi:10.1093/biomet/58.1.83. Do ads trigger each other?</li>
          <li>Cohen, Jacob. “A Coefficient of Agreement for Nominal Scales.” <i>Educational and Psychological Measurement</i> 20, no. 1 (1960): 37–46. doi:10.1177/001316446002000104. How far the readers agreed.</li>
          <li>Byrt, Ted, Janet Bishop, and John Carlin. “Bias, Prevalence and Kappa.” <i>Journal of Clinical Epidemiology</i> 46, no. 5 (1993): 423–429. doi:10.1016/0895-4356(93)90018-V.</li>
          <li>Kendall, Maurice. “A New Measure of Rank Correlation.” <i>Biometrika</i> 30, no. 1–2 (1938): 81–93. doi:10.1093/biomet/30.1-2.81. The prayer-and-jokes test.</li>
          <li>Holm, Sture. “A Simple Sequentially Rejective Multiple Test Procedure.” <i>Scandinavian Journal of Statistics</i> 6, no. 2 (1979): 65–70. JSTOR 4615733. Correcting for running many tests.</li>
        </ol>
      </section>
    </footer>
  </article>
  <Folio page={5} label="Articles" />

  <script type="application/json" id="mdm-data" set:html={JSON.stringify(data)}></script>
  <script>
    const D = JSON.parse(document.getElementById('mdm-data')!.textContent!);
    const NS = 'http://www.w3.org/2000/svg';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const el = (tag: string, a: Record<string, any> = {}, parent?: Element) => {
      const n = document.createElementNS(NS, tag);
      for (const k in a) n.setAttribute(k, String(a[k]));
      parent?.appendChild(n); return n;
    };
    const fmt = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    const ord = (n: number) => n + (['th', 'st', 'nd', 'rd'][(n % 100 - 20) % 10] || ['th', 'st', 'nd', 'rd'][n % 100] || 'th');

    // reveal on scroll
    const io = 'IntersectionObserver' in window && !reduce ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io!.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' }) : null;
    document.querySelectorAll('.reveal').forEach((n) => io ? io.observe(n) : n.classList.add('in'));

    // Figure 1: timeline
    (() => {
      const host = document.getElementById('timeline')!, out = document.getElementById('time-out')!;
      const W = 1000, H = 120, x0 = 20, x1 = 980;
      const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, class: 'svg' }, host);
      const t = (iso: string) => { const d = new Date(iso + 'T12:00:00'); return d.getFullYear() + (d.getMonth() * 30.4 + d.getDate()) / 365; };
      const X = (y: number) => x0 + (y - 1981) / (2026.6 - 1981) * (x1 - x0);
      el('line', { x1: x0, x2: x1, y1: 70, y2: 70, class: 'ax' }, svg);
      for (let y = 1985; y <= 2025; y += 5) {
        el('line', { x1: X(y), x2: X(y), y1: 70, y2: 76, class: 'ax' }, svg);
        const tx = el('text', { x: X(y), y: 96, class: 'lbl', 'text-anchor': 'middle' }, svg); tx.textContent = String(y);
      }
      const ads: string[] = [...new Set<string>(D.ads)];
      const special: Record<string, string> = { '1981-05-01': 'Exhibit I', '1989-05-01': 'Exhibit III', '2008-05-01': 'Exhibit IV', '2026-06-22': 'Exhibit II' };
      ads.forEach((a, i) => {
        const md = a.slice(5) >= '04-28' && a.slice(5) <= '05-02';
        const g = el('g', { class: 'tick', tabindex: 0 }, svg);
        const cx = X(t(a)), cy = md ? 52 : 34;
        el('rect', { x: cx - 6, y: 10, width: 12, height: 64, fill: 'transparent' }, g);
        el('circle', { cx, cy, r: special[a] ? 6 : 4, class: md ? 'dot-f' : 'dot-o' }, g);
        const show = () => { out.innerHTML = `<b>${fmt(a)}</b>${md ? ' · May Day ad' : ''}${special[a] ? ` · ${special[a]}, above and below` : ''}`; svg.querySelectorAll('.tick').forEach((n) => n.classList.remove('on')); g.classList.add('on'); };
        g.addEventListener('mouseenter', show); g.addEventListener('focus', show); g.addEventListener('click', show);
      });
      out.innerHTML = `<b>${ads.length - 1} ads</b> across 45 years. Not one May Day has been missed for long.`;
    })();

    // Figure 2: calendar
    (() => {
      const host = document.getElementById('calendar')!;
      const narrow = innerWidth < 600; const W = narrow ? 560 : 1000, H = narrow ? 460 : 380, L = 60, R = W - 20, T = 20, B = H - 50;
      const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, class: 'svg' }, host);
      const X = (y: number) => L + (y - 1986) / (2027 - 1986) * (R - L);
      const Y = (n: number) => B - (n - 455) / (498 - 455) * (B - T);
      el('line', { x1: L, x2: R, y1: B, y2: B, class: 'ax' }, svg);
      el('line', { x1: L, x2: L, y1: T, y2: B, class: 'ax' }, svg);
      for (let y = 1990; y <= 2025; y += (narrow ? 10 : 5)) { const tx = el('text', { x: X(y), y: B + 24, class: 'lbl', 'text-anchor': 'middle' }, svg); tx.textContent = String(y); }
      for (let n = 460; n <= 495; n += 5) { const tx = el('text', { x: L - 10, y: Y(n) + 4, class: 'lbl', 'text-anchor': 'end' }, svg); tx.textContent = ord(n); }
      el('line', { x1: X(1986.5), y1: Y(456.5), x2: X(2026.5), y2: Y(496.5), class: 'expect' }, svg);
      const guide = el('line', { y1: T, y2: B, class: 'guide' }, svg);
      const ring = el('circle', { r: 11, class: 'ring' }, svg);
      const dots: { y: number, n: number, ad: string, ho?: boolean, c: Element }[] = [];
      D.counts.forEach((c: any) => {
        const d = el('circle', { cx: X(c.year), cy: Y(c.n), r: c.holdout ? 6.5 : 5, class: c.holdout ? 'dot-o thick' : 'dot-f' }, svg);
        dots.push({ y: c.year, n: c.n, ad: c.ad, ho: c.holdout, c: d });
      });
      const yr = document.getElementById('yr') as HTMLInputElement, yy = document.getElementById('yr-y')!, yn = document.getElementById('yr-n')!, out = document.getElementById('cal-out')!;
      const upd = () => {
        const y = +yr.value; yy.textContent = String(y); yn.textContent = ord(y - 1530);
        guide.setAttribute('x1', String(X(y))); guide.setAttribute('x2', String(X(y)));
        ring.setAttribute('cx', String(X(y))); ring.setAttribute('cy', String(Y(y - 1530)));
        const hit = dots.filter((d) => d.y === y);
        out.innerHTML = hit.length
          ? `<b>${y}:</b> the ad${hit.length > 1 ? 's' : ''} printed <b>${hit.map((h) => ord(h.n)).join(' and ')}</b>. Correct.${hit.some((h) => h.ho) ? ' This was a locked prediction.' : ''}`
          : `<b>${y}:</b> no count printed that year. <b>34 of 34</b> printed counts sit on the line.`;
      };
      yr.addEventListener('input', upd); upd();
    })();

    // Figure 3: citations
    (() => {
      const host = document.getElementById('cites')!;
      const top = D.citations.top, p99 = D.citations.chance_p99;
      const W = 1000, rowH = 34, L = 170, R = 940, H = top.length * rowH + 40;
      const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, class: 'svg' }, host);
      const max = 45, X = (v: number) => L + v / max * (R - L);
      top.forEach((c: any, i: number) => {
        const y = 10 + i * rowH;
        const tx = el('text', { x: L - 14, y: y + 19, class: 'lbl', 'text-anchor': 'end' }, svg); tx.textContent = fmt(c.ad);
        const bar = el('rect', { x: L, y: y + 4, width: reduce ? X(c.n) - L : 0, height: rowH - 12, class: i === 0 ? 'bar-on' : 'bar' }, svg);
        (bar as any).dataset.w = X(c.n) - L;
        const v = el('text', { x: X(c.n) + 8, y: y + 19, class: 'lbl' + (i === 0 ? ' strong' : '') }, svg); v.textContent = String(c.n);
      });
      el('line', { x1: X(p99), x2: X(p99), y1: 4, y2: H - 28, class: 'chance' }, svg);
      const ct = el('text', { x: X(p99) + 6, y: H - 10, class: 'lbl ital' }, svg); ct.textContent = `chance ceiling: ${p99}`;
      const grow = () => svg.querySelectorAll('rect').forEach((r: any) => { r.style.transition = 'width .9s cubic-bezier(.2,.8,.2,1)'; r.setAttribute('width', r.dataset.w); });
      if (!reduce) { const o = new IntersectionObserver((es) => { if (es[0].isIntersecting) { grow(); o.disconnect(); } }, { threshold: .4 }); o.observe(host); }
    })();

    // Figure 4: graveyard
    (() => {
      const out = document.getElementById('grave-out')!; let n = 0;
      document.querySelectorAll<HTMLButtonElement>('.grave .card').forEach((b) => b.addEventListener('click', () => {
        if (b.getAttribute('aria-expanded') === 'true') return;
        b.setAttribute('aria-expanded', 'true'); b.classList.add('open'); n++;
        const all = [...document.querySelectorAll('.grave .card.open')].map((c) => (c as HTMLElement).dataset.fate);
        const died = all.filter((f) => f === 'Died').length, lived = all.filter((f) => f === 'Survived').length;
        out.textContent = n < 9 ? `${n} of 9 revealed · ${died} died, ${lived} survived so far` : `All 9 revealed: 5 died, 2 survived, 2 still undecided.`;
      }));
    })();

    // Figure 5: ladder
    (() => {
      const v = document.getElementById('rung-v')!, d = document.getElementById('rung-d')!, e = document.getElementById('rung-e')!;
      document.querySelectorAll<HTMLButtonElement>('.rung').forEach((b) => b.addEventListener('click', () => {
        document.querySelectorAll('.rung').forEach((r) => r.classList.remove('on')); b.classList.add('on');
        v.textContent = b.dataset.v!; d.textContent = b.dataset.d!; e.textContent = b.dataset.e!;
      }));
    })();

    // Figure 6: pray / joke scatter
    (() => {
      const host = document.getElementById('prayjoke')!, out = document.getElementById('pj-out')!;
      const narrow = innerWidth < 600; const W = narrow ? 560 : 1000, H = narrow ? 600 : 520, L = narrow ? 64 : 70, R = W - 30, T = 44, B = H - 60;
      const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, class: 'svg' }, host);
