---
import Section from '../layouts/Section.astro';
import { h } from '../data/site';
import { creative, experiments } from '../data/pages';
---
<Section
  description="Things Siddhant Tiwary is making: Set, an app for keeping the best moments of a DJ set, plus music, video and research projects."
  page={4}
  title="Creative projects"
  longTitle
  intro="Previews of what I’m trying to make, built in public."
  heads={[h('red-bellied-guenon'), h('red-handed-tamarin'), h('moloneys-monkey'), h('golden-lion-tamarin'), h('black-headed-uakari'), h('red-shanked-douc'), h('mandrill'), h('cotton-top-tamarin'), h('bearded-saki'), h('spot-nosed-monkey')]}
>
  <div class="cards">
    {creative.map((c) => {
      const Tag = c.href ? 'a' : 'article';
      return (
        <Tag class="card" {...(c.href ? { href: c.href, target: '_blank', rel: 'noopener' } : {})}>
          {c.preview ? (
            <img class="preview" src={c.preview} alt={`Preview of ${c.title}`} loading="lazy" />
          ) : (
            <span class="preview" aria-hidden="true"><span class="preview-label">Plate to come</span></span>
          )}
          {c.credit && <span class="photo-credit">{c.credit}</span>}
          <span class="meta" style="margin-top:12px">{c.meta}</span>
          <h2 class="item-title" style="margin:4px 0 0">{c.title}</h2>
          <p class="item-sum" style="margin:5px 0 0">{c.summary}</p>
          {c.href && <span class="open-link">Open {c.title} ↗</span>}
        </Tag>
      );
    })}
  </div>

  <h2 class="subhead" style="margin-top:48px">Experiments</h2>
  <div class="cards" style="margin-top:0;border-top:0">
    {experiments.map((e) => (
      <article class="card">
        <a href={e.href} style="text-decoration:none;color:inherit;display:block">
          <img class="preview" src={e.preview} alt={`Preview of ${e.title}`} loading="lazy" />
          <span class="meta" style="margin-top:12px">{e.meta}</span>
          <h3 class="item-title" style="margin:4px 0 0">{e.title}</h3>
          <p class="item-sum" style="margin:5px 0 0">{e.summary}</p>
        </a>
        <span style="display:flex;gap:18px;flex-wrap:wrap">
          <a class="open-link" href={e.href}>{e.href.startsWith('/articles') ? 'Read the write-up' : 'See the results'} ↗</a>
          {e.code && <a class="open-link" href={e.code} target="_blank" rel="noopener">Code on GitHub ↗</a>}
        </span>
      </article>
    ))}
  </div>
</Section>
